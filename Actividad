// Función recursiva para calcular el factorial de un número
int factorial(int n) {
    // Caso base: si n es 0 o 1, el factorial es 1
    if (n <= 1) {
        return 1;
    }
    // Llamada recursiva: n * factorial(n - 1)
    return n * factorial(n - 1);
}

int main() {
    int numero = 4;
    int resultado = factorial(numero);
    return resultado;
}
